NODE_ENV=development
PORT=3000

# Comma-separated browser origins allowed to call the API.
# Add deployed frontend URLs here, e.g. https://app.example.com.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=postgresql://user:password@localhost:5432/ai_judge?schema=public

# --------------------------------------------------------------------
# LLM provider selection
# --------------------------------------------------------------------
# LLM_PROVIDER is an explicit selector. Accepted values:
#   claude_cli  — spawn the `claude` CLI subprocess (free via your
#                 logged-in Claude subscription). Dev-only — needs
#                 the `claude` binary in PATH.
#   anthropic   — use the Anthropic SDK with ANTHROPIC_API_KEY. Prod.
#                 Calls are metered against your account.
#   ollama      — local llama via OLLAMA_BASE_URL. Useful for offline.
#
# If LLM_PROVIDER is unset, the factory falls back to a heuristic
# (API key implies anthropic, otherwise ollama). Setting it
# explicitly is the recommended pattern — silent fallbacks have
# bitten ops in the past.
#
# Recommended split:
#   Local dev:   LLM_PROVIDER=claude_cli  (ANTHROPIC_API_KEY can stay blank)
#   Production:  LLM_PROVIDER=anthropic   + ANTHROPIC_API_KEY=sk-...
LLM_PROVIDER=claude_cli

ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-7
LLM_MAX_TOKENS=4096

# Per-attempt LLM call timeout (ms). Defaults to 90s. Bump for large
# cache-cold sonnet/opus runs that routinely sit at 100-200s.
# LLM_TIMEOUT_MS=240000

# Per-agent input-token warn threshold + plan.md truncation cap.
# Both auto-derive from the model's context window at call time
# (75% of context for the warn threshold, 5% for plan.md cap). Set
# these env vars only to override the derived value with a fixed
# number — useful when sweeping in the eval harness or when you
# want a tighter ceiling than the model's full context. Leave
# unset for normal operation.
#
# PLAN_AGENT_INPUT_TOKEN_WARN=150000
# BUILD_AGENT_INPUT_TOKEN_WARN=150000
# MENTOR_AGENT_INPUT_TOKEN_WARN=150000
# SIGNAL_MENTOR_AGENT_INPUT_TOKEN_WARN=150000
# PLAN_MD_TRUNCATION_CAP=50000

# Optional: local development via Ollama. Required when
# LLM_PROVIDER=ollama; otherwise unused.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

RUBRIC_VERSION=v2.0
RUBRIC_DIR=./rubrics

# Pattern-drill content bank (backend/pattern-drills/bank.yaml).
# PATTERN_DRILL_BANK_PATH=./pattern-drills/bank.yaml

CLAUDE_CODE_PROJECTS_DIR=/Users/parinita/.claude/projects

# Symmetric HS256 signing key for JWTs. Required.
# Generate with: openssl rand -hex 32
# 32 bytes hex = 256 bits = current best-practice HS256 key length.
JWT_SECRET=

# Per-user daily LLM spend cap (USD). CostCapService.assertWithinCap
# blocks LLM calls when SUM(estimated_cost_usd) since UTC midnight
# reaches this value. Defaults to $5.00 if unset.
LLM_DAILY_CAP_USD=5.00
